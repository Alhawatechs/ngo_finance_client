# Copy to .env.local and set your API URL. Never commit .env.local or secrets.
# Optional: full API base for direct browser calls (e.g. http://localhost:8000/api/v1). Requires CORS.
# Leave unset to use same-origin /api/v1 (Next proxy) — avoids "Failed to fetch" from cross-origin CORS.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: Axios request timeout in ms (default 120000). Increase if you see "timeout of 30000ms exceeded".
# NEXT_PUBLIC_API_TIMEOUT_MS=180000
NEXT_PUBLIC_APP_NAME="AADA ERP Finance"
NEXT_PUBLIC_APP_URL=http://localhost:3000
